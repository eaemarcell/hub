<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIGHE - Sistema Integrado de Gestão de Horas Extras</title>


    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Estilos Customizados -->
    <link rel="stylesheet" href="styles.css">
</head>
<body class="bg-slate-100 font-sans text-slate-800 antialiased min-h-screen">

    <!-- ==================== TELA 1: LOGIN ==================== -->
    <div id="view-login" class="flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-md bg-white rounded-xl shadow-lg border border-slate-200 p-8">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center mb-4">
    			<img src="icon.svg" class="h-16 w-auto object-contain" alt="Logo AMT">
		</div>
                <!--<h1 class="text-2xl font-bold text-slate-900">SIGHE</h1>
		<h1 class="text-2xl font-bold text-slate-900">Sistema Integrado de Gestão de Horas Extras</h1>-->
                <p class="text-slate-500 text-sm mt-1">Acesse sua conta para continuar</p>
            </div>

            <form id="form-login" onsubmit="event.preventDefault(); fazerLogin();" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">E-mail</label>
                    <input type="email" id="login-email" required placeholder="seu.email@empresa.com" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Senha</label>
                    <input type="password" id="login-senha" required placeholder="••••••••" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                </div>
                <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm transition">Entrar</button>
            </form>
        </div>
    </div>

    <!-- ==================== ESTRUTURA PRINCIPAL (APÓS LOGIN) ==================== -->
    <div id="view-dashboard" class="hidden min-h-screen flex flex-col">
        
        <!-- Header / Navbar -->
        <header class="bg-white border-b border-slate-200 px-6 py-4 flex justify-between items-center sticky top-0 z-10">
            <div class="flex items-center space-x-3">
                <div class="flex items-center justify-center">
    			<img src="icon.svg" class="h-8 w-auto object-contain" alt="Logo AMT">
		</div>
                <div>
                    <h2 class="font-bold text-slate-900 text-lg">SIGHE - Sistema Integrado de Gestão de Horas Extras</h2>
                    <span id="user-role-badge" class="inline-block px-2 py-0.5 text-xs font-semibold rounded-full bg-slate-100 text-slate-600"></span>
                </div>
            </div>

            <div class="flex items-center space-x-4">
                <div class="text-right hidden sm:block">
                    <p id="user-name" class="text-sm font-semibold text-slate-900"></p>
                    <p id="user-email" class="text-xs text-slate-500"></p>
                </div>
                <button onclick="fazerLogout()" class="text-slate-500 hover:text-red-600 p-2 rounded-lg hover:bg-slate-100 transition" title="Sair">
                    <i data-lucide="log-out" class="w-5 h-5"></i>
                </button>
            </div>
        </header>

        <!-- Navegação de Abas -->
        <div class="bg-white border-b border-slate-200 px-6">
            <nav class="flex space-x-6">
                <button id="tab-btn-horas" onclick="alternarAba('horas')" class="py-3 px-1 font-medium text-sm border-b-2 border-blue-600 text-blue-600 flex items-center space-x-2">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    <span>Minhas Horas Extras</span>
                </button>
                <button id="tab-btn-admin" onclick="alternarAba('admin')" class="hidden py-3 px-1 font-medium text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-700 flex items-center space-x-2">
                    <i data-lucide="shield-check" class="w-4 h-4"></i>
                    <span>Painel do Administrador</span>
                </button>
            </nav>
        </div>

        <!-- Conteúdo Principal -->
        <main class="flex-1 p-6 max-w-7xl w-full mx-auto space-y-6">

            <!-- TAB 1: LANÇAMENTO DE HORAS EXTRAS -->
            <div id="tab-content-horas" class="space-y-6">
                
                <!-- Card de Cadastro / Edição -->
                <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200">
                    <div class="flex justify-between items-center mb-4">
                        <h3 id="titulo-form-he" class="text-lg font-semibold flex items-center gap-2">
                            <i data-lucide="file-plus" class="w-5 h-5 text-blue-600"></i> Registrar Nova Hora Extra
                        </h3>
                        
                        <!-- Ações Exibidas Apenas na Edição -->
                        <div id="acoes-edicao-he" class="hidden flex items-center space-x-3">
                            <button id="btn-excluir-he" type="button" onclick="excluirHoraExtra()" class="px-3 py-1 bg-red-100 hover:bg-red-200 text-red-700 font-medium rounded-lg text-xs transition flex items-center gap-1" title="Excluir este registro">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Excluir Registro
                            </button>
                            <button id="btn-cancelar-edicao" type="button" onclick="cancelarEdicaoHoraExtra()" class="text-xs text-slate-500 hover:text-slate-700 underline font-medium">
                                Cancelar Edição
                            </button>
                        </div>
                    </div>
                    
                    <form id="form-hora-extra" onsubmit="event.preventDefault(); registrarHoraExtra();" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <input type="hidden" id="he-id-editando" value="">

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Data *</label>
                            <input type="date" id="he-data" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Hora Início *</label>
                            <input type="time" id="he-inicio" required onchange="calcularTotalHoras()" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Hora Fim *</label>
                            <input type="time" id="he-fim" required onchange="calcularTotalHoras()" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Total Calculado</label>
                            <input type="text" id="he-total-horas" readonly placeholder="00h 00m" class="w-full px-3 py-2 border rounded-lg text-sm bg-slate-50 font-bold text-blue-600">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Nº do Chamado *</label>
                            <input type="text" id="he-sa" required placeholder="Ex: SA-10293" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Nome do Requerente *</label>
                            <input type="text" id="he-requerente" required placeholder="Ex: Carlos Silva" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Situação / Sobreaviso *</label>
                            <select id="he-tipo-acionamento" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                                <option value="">-- Selecione uma opção --</option>
                                <option value="Sim, estou de sobreaviso">Sim, estou de sobreaviso</option>
                                <option value="Não, porém fui acionado fora do horário comercial">Não, porém fui acionado fora do horário comercial</option>
                            </select>
                        </div>

                        <div class="md:col-span-3">
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Motivo / Descrição *</label>
                            <input type="text" id="he-motivo" required placeholder="Descreva brevemente a atividade realizada" class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div class="flex items-end">
                            <button type="submit" class="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm transition flex justify-center items-center gap-2">
                                <i data-lucide="send" class="w-4 h-4"></i> <span id="btn-salvar-he-texto">Salvar Horas</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Lista de Registros do Usuário -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-4 border-b border-slate-200 flex justify-between items-center">
                        <h3 class="font-semibold text-slate-800">Meus Registros Recentes</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-sm">
                            <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
                                <tr>
                                    <th class="p-3">Data</th>
                                    <th class="p-3">Chamado</th>
                                    <th class="p-3">Requerente</th>
                                    <th class="p-3">Horário / Total</th>
                                    <th class="p-3">Situação</th>
                                    <th class="p-3">Motivo</th>
                                    <th class="p-3">Status</th>
                                    <th class="p-3 text-right">Ação</th>
                                </tr>
                            </thead>
                            <tbody id="lista-minhas-horas" class="divide-y divide-slate-100">
                                <!-- Preenchido via Javascript -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 2: PAINEL ADMINISTRATIVO -->
            <div id="tab-content-admin" class="hidden space-y-6">
                
                <!-- Gestão de Usuários -->
                <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-200">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-semibold flex items-center gap-2">
                            <i data-lucide="users" class="w-5 h-5 text-blue-600"></i> Gerenciamento de Colaboradores
                        </h3>
                        <button onclick="abrirModalUsuario()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg text-sm transition flex items-center gap-2">
                            <i data-lucide="user-plus" class="w-4 h-4"></i> Novo Colaborador
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-sm">
                            <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
                                <tr>
                                    <th class="p-3">Nome</th>
                                    <th class="p-3">E-mail</th>
                                    <th class="p-3">Perfis / Grupos</th>
                                    <th class="p-3 text-right">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="lista-usuarios" class="divide-y divide-slate-100">
                                <!-- Preenchido via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Visão Geral de Todas as Horas Registradas -->
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                        <h3 class="font-semibold text-slate-800 flex items-center gap-2">
                            <i data-lucide="database" class="w-5 h-5 text-blue-600"></i> Todas as Horas Extras Registradas (Visão Admin)
                        </h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-sm">
                            <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
                                <tr>
                                    <th class="p-3">Colaborador</th>
                                    <th class="p-3">Data</th>
                                    <th class="p-3">Chamado</th>
                                    <th class="p-3">Requerente</th>
                                    <th class="p-3">Horário / Total</th>
                                    <th class="p-3">Situação</th>
                                    <th class="p-3">Motivo</th>
                                    <th class="p-3 text-right">Ação</th>
                                </tr>
                            </thead>
                            <tbody id="lista-todas-horas" class="divide-y divide-slate-100">
                                <!-- Preenchido via Javascript -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- ==================== MODAL: ADICIONAR USUÁRIO ==================== -->
    <div id="modal-usuario" class="hidden fixed inset-0 bg-slate-900/50 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-xl border border-slate-200 w-full max-w-md p-6 space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="font-bold text-lg text-slate-900">Cadastrar Colaborador</h3>
                <button onclick="fecharModalUsuario()" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>

            <form id="form-usuario" onsubmit="event.preventDefault(); salvarUsuario();" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Nome Completo *</label>
                    <input type="text" id="usr-nome" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">E-mail *</label>
                    <input type="email" id="usr-email" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Senha Inicial *</label>
                    <input type="password" id="usr-senha" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-2">Grupos de Acesso (Selecione ao menos um) *</label>
                    <div class="space-y-2 bg-slate-50 p-3 rounded-lg border border-slate-200">
                        <label class="flex items-center space-x-2 text-sm text-slate-700 cursor-pointer">
                            <input type="checkbox" id="usr-amt" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                            <span>Analista AMT</span>
                        </label>
                        <label class="flex items-center space-x-2 text-sm text-slate-700 cursor-pointer">
                            <input type="checkbox" id="usr-externo" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                            <span>Analista Externo</span>
                        </label>
                        <label class="flex items-center space-x-2 text-sm text-slate-700 cursor-pointer">
                            <input type="checkbox" id="usr-admin" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                            <span class="font-semibold text-purple-700">Administrador</span>
                        </label>
                    </div>
                </div>

                <div class="flex space-x-3 pt-2">
                    <button type="button" onclick="fecharModalUsuario()" class="w-1/2 py-2 border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50">Cancelar</button>
                    <button type="submit" class="w-1/2 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Script Principal JS -->
    <script src="script.js"></script>
</body>
</html>
